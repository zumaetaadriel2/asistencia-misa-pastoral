# Variables de entorno de la app (Next.js)
# =============================================
# En desarrollo con Supabase local, `npm run db:start` muestra estos valores.
# En producción: Settings → API Keys del proyecto de Supabase (clave publishable, no la anon legacy).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# Los secretos de R2 no van aquí: viven en las Edge Functions (ver supabase/functions/.env.example)
