# Variables de entorno de la app (Next.js)
# =============================================
# En desarrollo con Supabase local, `npm run db:start` muestra estos valores.
# En producción: Settings → API Keys del proyecto de Supabase (clave publishable, no la anon legacy).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# Client ID de OAuth de Google (Google Cloud → Google Auth Platform → Clients). Es público.
# Sin él, el login usa solo la redirección de Supabase, cuya ventana muestra el dominio de Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Los secretos de R2 no van aquí: viven en las Edge Functions (ver supabase/functions/.env.example)

# Solo en desarrollo local (.env.development.local): muestra el login con correo para el staff ficticio del seed
# NEXT_PUBLIC_LOGIN_CON_CORREO=true
