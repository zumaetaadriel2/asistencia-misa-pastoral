# Secretos de las Edge Functions.
# En local: copiar a supabase/functions/.env (ignorado por git) con el token "asistencia-dev".
# En producción: `npx supabase secrets set ...` con el token "asistencia-produccion".

# Cloudflare R2 (R2 → Overview → Account Details)
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET=asistencia-fotos-dev

# Orígenes que pueden llamar a las funciones, separados por comas
ORIGENES_PERMITIDOS=http://localhost:3000,http://127.0.0.1:3000
